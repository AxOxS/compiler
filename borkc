"""Entry point for Bork compiler"""
import os, sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from bork.errors import BorkError
from bork.lexer import tokenize

USAGE = "usage: borkc tokens <file.bk>\n"

def cmd_tokens(path):
    try:
        with open(path, encoding="utf-8") as handle:
            source = handle.read()
    except OSError as exc:
        sys.stderr.write(f"borkc: cannot read {path}: {exc.strerror}\n")
        return 2

    try:
        for token in tokenize(source, path):
            value = "" if token.value is None else f"   {token.value!r}"
            sys.stdout.write(f"{token.span.line:>4}:{token.span.col:<4} {token.kind:<6}{value}\n")
    except BorkError as exc:
        sys.stderr.write(exc.render() + "\n")
        return 1
    return 0

def main(argv):
    if len(argv) == 2 and argv[0] == "tokens":
        return cmd_tokens(argv[1])
    sys.stderr.write(USAGE)
    return 2

if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
